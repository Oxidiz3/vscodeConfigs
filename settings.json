{
    "editor.renderWhitespace": "none",
    "explorer.confirmDragAndDrop": false,
    "editor.suggestSelection": "first",
    "files.associations": {
        "*.xml": "xml"
    },
    "git.enableSmartCommit": true,
    "editor.fontFamily": "consolas",
    "editor.fontLigatures": true,
    "vim.incsearch": true,
    "vim.hlsearch": true,
    "vim.leader": "\\",
    "vim.handleKeys": {
        "<C-a>": true,
        "<C-f>": false,
        "gi": false
    },
    "vim.visualModeKeyBindingsNonRecursive": [
        {
            "before": [
                ">"
            ],
            "commands": [
                "editor.action.indentLines"
            ]
        },
        {
            "before": [
                "<"
            ],
            "commands": [
                "editor.action.outdentLines"
            ]
        },
        {
            "before": [
                "<space>"
            ],
            "commands": [
                "whichkey.show"
            ]
        }
    ],
    "vim.commandLineModeKeyBindings": [],
    "editor.stickyTabStops": true,
    "python.languageServer": "Jedi",
    "explorer.confirmDelete": false,
    "workbench.editorAssociations": {
        "*.ipynb": "jupyter-notebook"
    },
    "vim.cursorStylePerMode.insert": "line",
    "vim.cursorStylePerMode.normal": "block",
    "vim.cursorStylePerMode.replace": "block-outline",
    "vim.cursorStylePerMode.visual": "underline",
    "vim.cursorStylePerMode.visualblock": "underline",
    "vim.cursorStylePerMode.visualline": "underline",
    "vim.foldfix": true,
    "vim.highlightedyank.enable": true,
    "vim.useSystemClipboard": true,
    "notebook.cellToolbarLocation": {
        "default": "right",
        "jupyter-notebook": "left"
    },
    "security.workspace.trust.untrustedFiles": "open",
    "csharp.semanticHighlighting.enabled": true,
    "workbench.preferredDarkColorTheme": "Monokai Dimmed",
    "git.confirmSync": false,
    "vim.replaceWithRegister": true,
    "editor.codeLensFontFamily": "consolas",
    "scm.inputFontFamily": "editor",
    "debug.console.fontFamily": "Consolas",
    "git.autofetch": true,
    "terminal.integrated.fontFamily": "monospace",
    "debug.javascript.autoAttachFilter": "smart",
    "terminal.integrated.defaultProfile.windows": "PowerShell",
    "[javascript]": {
        "editor.defaultFormatter": "vscode.typescript-language-features"
    },
    "prettier.semi": false,
    "prettier.useTabs": true,
    "editor.formatOnSaveMode": "modificationsIfAvailable",
    "omnisharp.useModernNet": false,
    "editor.guides.bracketPairs": true,
    "[dart][python]": {
        "editor.wordBasedSuggestions": "off"
    },
    "terminal.integrated.enableMultiLinePasteWarning": "never",
    "editor.formatOnPaste": true,
    "python.defaultInterpreterPath": "C:\\Users\\mecha\\AppData\\Local\\Microsoft\\WindowsApps\\python3.12.exe",
    "extensions.experimental.affinity": {
        "asvetliakov.vscode-neovim": 1
    },
    "github.copilot.advanced": {
        "authProvider": "github"
    },
    "workbench.colorTheme": "Gruvbox Dark Hard",
    "workbench.sideBar.location": "right",
    "workbench.activityBar.location": "top",
    "security.workspace.trust.enabled": false,
    "dotnet.codeLens.enableReferencesCodeLens": false,
    "editor.cursorSurroundingLines": 20,
    "metaGo.decoration.additionalSingleCharCodeCharacters": "z",
    "metaGo.decoration.characters": "k, j, d, f, l, s, a, h, g, i, o, n, u, r, v, c, w, e, x, m, b, p, q, t, y",
    "workbench.layoutControl.enabled": false,
    "window.commandCenter": false,
    "window.customTitleBarVisibility": "windowed",
    "zenMode.hideLineNumbers": false,
    "whichkey.bindings": [
        {
            "key": "e",
            "name": "[E]ditor",
            "type": "bindings",
            "bindings": [
                {
                    "key": "f",
                    "name": "[E]ditor [F]ile Explorer",
                    "args": {
                        "commands": [
                            "workbench.files.action.focusFilesExplorer"
                        ]
                    },
                    "command": "runCommands",
                },
                {
                    "key": "g",
                    "name": "[E]ditor [G]it Tab",
                    "args": {
                        "commands": [
                            "workbench.view.scm"
                        ]
                    },
                    "command": "runCommands",
                },
                {
                    "key": "c",
                    "name": "[E]ditor [C]opilot",
                    "args": {
                        "commands": [
                            "workbench.action.chat.open"
                        ]
                    },
                    "command": "runCommands",
                },
                {
                    "key": "d",
                    "name": "[E]ditor [D]ebug",
                    "args": {
                        "commands": [
                            "workbench.view.debug"
                        ]
                    },
                    "command": "runCommands",
                },
                {
                    "key": "t",
                    "name": "[E]ditor [T]erminal",
                    "args": {
                        "commands": [
                            "workbench.action.terminal.toggleTerminal"
                        ]
                    },
                    "command": "runCommands",
                },
                {
                    "key": "p",
                    "name": "[E]ditor Command [P]alette",
                    "args": {
                        "commands": [
                            "workbench.action.showCommands"
                        ]
                    },
                    "command": "runCommands",
                },
                {
                    "key": "s",
                    "name": "[E]ditor [S]ettings",
                    "args": {
                        "commands": [
                            "workbench.action.openSettings"
                        ]
                    },
                    "command": "runCommands",
                },
                {
                    "key": "l",
                    "name": "[E]ditor Extensions [L]",
                    "args": {
                        "commands": [
                            "workbench.view.extensions"
                        ]
                    },
                    "command": "runCommands",
                },
            ],
        },
        {
            "key": "w",
            "name": "[W]indow",
            "type": "bindings",
            "bindings": [
                {
                    "key": "h",
                    "name": "[W]indow Split [H]orizontally",
                    "command": "workbench.action.splitEditor",
                },
                {
                    "key": "v",
                    "name": "[W]indow Split [V]ertically",
                    "command": "workbench.action.splitEditorDown",
                },
                {
                    "key": "z",
                    "name": "[W]indow [Z]en Mode",
                    "command": "workbench.action.toggleZenMode",
                },
                {
                    "key": "p",
                    "name": "[W]indow Toggle [P]in",
                    "command": "workbench.action.pinEditor",
                },
                {
                    "key": "u",
                    "name": "[W]indow [U]nPin Editor",
                    "command": "workbench.action.unpinEditor",
                },
                {
                    "key": "c",
                    "name": "[W]indow [C]lose Window",
                    "command": "workbench.action.closeActiveEditor",
                },
            ],
        },
        {
            "key": "g",
            "name": "[G]oto",
            "type": "bindings",
            "bindings": [
                {
                    "key": "p",
                    "name": "[G]oto [P]eek",
                    "command": "editor.action.peekDefinition",
                },
                {
                    "key": "m",
                    "name": "[G]oto Sy[m]bol",
                    "command": "workbench.action.gotoSymbol",
                },
                {
                    "name": "[G]oto [D]efinition",
                    "key": "d",
                    "command": "editor.action.revealDefinition",
                },
                {
                    "name": "[G]oto [S]earch",
                    "key": "s",
                    "args": {
                        "commands": [
                            "editor.action.addSelectionToNextFindMatch",
                            "editor.action.clipboardCopyAction",
                            "workbench.action.findInFiles"
                        ]
                    },
                    "command": "runCommands",
                },
                {
                    "name": "[G]oto [F]ile (ctrl+p)",
                    "key": "f",
                    "args": {
                        "commands": [
                            "editor.action.addSelectionToNextFindMatch",
                            "editor.action.clipboardCopyAction",
                            "workbench.action.quickOpen"
                            // Have to press ctrl+v after command to paste your search
                        ]
                    },
                    "command": "runCommands",
                },
                {
                    "key": "r",
                    "name": "[G]oto [R]eferences",
                    "command": "editor.action.goToReferences",
                },
                {
                    "key": "i",
                    "name": "[G]oto [I]mplementation",
                    "command": "editor.action.goToImplementation",
                },
                {
                    "key": "e",
                    "name": "[G]oto [E]rror",
                    "command": "editor.action.marker.next",
                },
                {
                    "key": ",",
                    "name": "[G]oto Show All Editors [,]",
                    "command": "workbench.action.showAllEditors",
                },
            ],
        },
        {
            "key": "x",
            "name": "[X] Document",
            "type": "bindings",
            "bindings": [
                {
                    "key": "f",
                    "name": "[X] Document [F]ormat Document",
                    "command": "editor.action.formatDocument",
                },
                {
                    "key": "b",
                    "name": "[X] Document Git [B]lame",
                    "command": "gitlens.toggleFileBlame:key",
                },
            ],
        },
        {
            "key": "d",
            "name": "[D]ebug",
            "type": "bindings",
            "bindings": [
                {
                    "key": "b",
                    "name": "[D]ebug Toggle [B]reakpoint",
                    "command": "editor.debug.action.toggleBreakpoint",
                },
                {
                    "key": "s",
                    "name": "[D]ebug [S]tart Debugging",
                    "command": "workbench.action.debug.start",
                },
                {
                    "key": "q",
                    "name": "[D]ebug [Q]uit Debugging",
                    "command": "workbench.action.debug.stop",
                },
            ],
        },
        // {
        //     "key": "m",
        //     "name": "Move",
        //     "type": "bindings",
        //     "bindings": [
        //         {
        //             "key": "h",
        //             "name": "<- Move to window left",
        //             "command": "editor.debug.action.toggleBreakpoint",
        //         },
        //     ],
        // },
        {
            "key": "o",
            "name": "[O]pen",
            "type": "bindings",
            "bindings": [
                {
                    "key": "s",
                    "name": "[O]pen [S]olution",
                    "command": "csdevkit.openSolution",
                },
                {
                    "key": "p",
                    "name": "[O]pen [P]roject Folder",
                    "command": "workbench.action.files.openFolder",
                },
                {
                    "key": "f",
                    "name": "[O]pen [F]ile",
                    "command": "workbench.action.files.openFile",
                },
            ],
        },
        {
            "key": "s",
            "name": "[S]plit",
            "type": "bindings",
            "bindings": [
                {
                    "key": "h",
                    "name": "[S]plit [H]orizontally",
                    "command": "workbench.action.splitEditorRight",
                },
                {
                    "key": "v",
                    "name": "[S]plit [V]ertically",
                    "command": "workbench.action.splitEditorDown",
                },
            ],
        },
        {
            "key": "t",
            "name": "[T]abs",
            "type": "bindings",
            "bindings": [
                {
                    "key": "c",
                    "name": "[T]abs [C]lose",
                    "command": "workbench.action.closeActiveEditor",
                },
                {
                    "key": "p",
                    "name": "[T]abs [P]in",
                    "command": "workbench.action.pinEditor",
                },
                {
                    "key": "u",
                    "name": "[T]abs [U]nPin",
                    "command": "workbench.action.unpinEditor",
                },
            ],
        },
        {
            "key": "c",
            "name": "[C]",
            "type": "bindings",
            "bindings": [
                {
                    "key": "e",
                    "name": "[C]oPilot [E]xplain",
                    "command": "github.copilot.chat.explain",
                },
                {
                    "key": "i",
                    "name": "[C]oPilot [I]nline Chat",
                    "command": "inlineChat.start",
                },
                {
                    "key": "c",
                    "name": "[C]oPilot [C]hat",
                    "command": "workbench.action.chat.open",
                },
                {
                    "key": "p",
                    "name": "[C]opy File [P]ath",
                    "command": "copyFilePath",
                },
                {
                    "key": "s",
                    "name": "[C]ode [S]uggestion",
                    "command": "editor.action.triggerSuggest",
                },
                {
                    "key": "r",
                    "name": "[C]ode [r]efactor",
                    "command": "editor.action.refactor",
                },
                {
                    "key": "h",
                    "name": "[C]ode [H]over",
                    "command": "editor.action.showDefinitionPreviewHover",
                }
            ],
        },
    ],
    // Use this to work with vim extensions https://github.com/VSCodeVim/Vim?tab=readme-ov-file#vim-easymotion
    "vim.normalModeKeyBindingsNonRecursive": [
        //EasyMotion Stuff
        {
            "before": [
                ";"
            ],
            "after": [
                "\\",
                "\\",
                "s"
            ]
        },
        {
            "before": [
                "<space>"
            ],
            "commands": [
                "whichkey.show"
            ]
        }
    ],
    "vim.showMarksInGutter": true,
    "workbench.iconTheme": "gruvbox-material-icon-theme",
    "vim.easymotion": true,
    "csharp.debug.logging.diagnosticsLog.startDebuggingTracing": true,
    "csharp.debug.logging.moduleLoad": false,
    "csharp.debug.logging.elapsedTiming": true,
    "csharp.debug.debugConsoleVerbosity": "verbose",
    "diffEditor.ignoreTrimWhitespace": true,
    "[jsonc]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    },
    "NugetGallery.credentialProviderFolder": "{user-profile}/.nuget/plugins/netcore/CredentialProvider.Microsoft",
    "NugetGallery.skipRestore": "false",
    "NugetGallery.sources": [
        "{\"name\":\"nuget.org\",\"url\":\"https://api.nuget.org/v3/index.json\"}"
    ],
    "github.copilot.nextEditSuggestions.enabled": true,
    "powershell.promptToUpdatePowerShell": false,
    "chat.mcp.gallery.enabled": true,
    "github.copilot.enable": {
        "*": true,
        "plaintext": false,
        "markdown": false,
        "scminput": false
    },
    "remote.SSH.remotePlatform": {
        "littlepc.nord": "linux"
    },
    "startupScripts.commands": [
        {
            "label": "config repo",
            "command": "cd ~/AppData/Roaming/Code/User/; ~/AppData/Roaming/Code/User/scripts/IsGitConfigCurrent.ps1"
        },
    ],
    "cSpell.userWords": [
        "LASTEXITCODE",
        "Melaleuca",
        "toplevel",
        "vnode",
        "worktree",
        "worktrees"
    ],
    "runTerminalCommand.commands": [
        {
            "command": "CreateJsonFilesForHbsScripts.ps1",
            "auto": true,
            "group": "FE Team"
        },
        {
            "command": "PrepareRte.ps1",
            "auto": true,
            "group": "FE Team"
        },
    ],
    "[vue]": {
        "editor.defaultFormatter": "Vue.volar"
    },
    "editor.stickyScroll.maxLineCount": 10,
    "diffEditor.renderSideBySide": false,
    "vim.smartRelativeLine": true,
    "chat.viewSessions.orientation": "stacked",
    "gitlens.ai.model": "vscode",
    "gitlens.ai.vscode.model": "copilot:gpt-4.1",
    "workbench.editor.enablePreview": false,
    "git.blame.editorDecoration.enabled": true,
    "chat.permissions.default": "autoApprove",
    "chatgpt.followUpQueueMode": "steer",
    "aws.cloudformation.telemetry.enabled": false,
    "window.title": "${dirty}${rootNameShort}",
}